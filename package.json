{
  "name": "crunchi",
  "productName": "Crunchi",
  "version": "1.0.1",
  "description": "A desktop app that compresses music into gloriously crunchy artifacts.",
  "main": "main.js",
  "author": "Adam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamstew4649/crunchi.git"
  },
  "homepage": "https://github.com/adamstew4649/crunchi#readme",
  "bugs": {
    "url": "https://github.com/adamstew4649/crunchi/issues"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.adam.crunchi",
    "productName": "Crunchi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "js/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
